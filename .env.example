# SOCMINT Environment Configuration
# Copy this file to .env in the project root and fill in values:
#   cp .env.example .env
#
# Restart backend after changes: uvicorn main:app --reload --host 127.0.0.1 --port 8000

# ─── REQUIRED FOR SPECIFIC TOOLS ─────────────────────────────────────────────

# Shodan — REQUIRED for infra_intel (IP/domain infrastructure search)
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# ─── SAMURAI — Instagram / Facebook deep intel ────────────────────────────────
# Full payload always (posts, reels, comments, similar profiles).
# Phased parallelism (safe workers=3) avoids OOM; wall cap 3 minutes.
# SAMURAI_WALL_SEC=180
# SAMURAI_SAFE_WORKERS=3
#
# Instagram bio + comment TEXT require a logged-in session (same as running
# `python main.py ig <user>` with IG_SESSIONID exported in your terminal).
#
# Option A — add to project root .env (restart uvicorn after saving):
#   IG_SESSIONID=your_sessionid_cookie_value
#
# Option B — export cookies.txt from browser (Get cookies.txt LOCALLY) to:
#   samurai/cookies.txt
#   or set IG_COOKIES_FILE=/path/to/cookies.txt
#
# Option C — inline cookie header fragment:
#   IG_COOKIES=sessionid=...; csrftoken=...; ds_user_id=...
#
# Facebook session (optional, for friends/photos):
#   FB_C_USER=...
#   FB_XS=...
#   FB_COOKIES_FILE=samurai/facebook_cookies.txt
#
# IG_SESSIONID=

# Apify — Instagram comment scraper (Samurai post/reel comments in UI)
# Get token: https://console.apify.com/account/integrations
# APIFY_API_TOKEN=
# Optional: Apify actor for Instagram post timestamps (default nH2AHrwxeTRJoN5hX)
# APIFY_IG_POSTS_ACTOR=nH2AHrwxeTRJoN5hX

# ─── OPTIONAL — GOOGLE DORKING ───────────────────────────────────────────────

# Default: free ddgs web search (no API keys, supports dork operators).
# Optional paid mode: GOOGLE_DORKING_MODE=api + GOOGLE_CUSTOM_SEARCH_* keys
# GOOGLE_DORKING_MODE=web
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=

# ─── IMAGE INTELLIGENCE ENGINE (required) ────────────────────────────────────

# Parallel image tool concurrency
# IMAGE_IO_CONCURRENCY=5   # reverse search + metadata (network/light)
# IMAGE_ML_CONCURRENCY=1   # face/OCR/YOLO models (keep at 1 on CPU)

# InsightFace downloads ~275MB model on first face analysis run.

# ─── OPTIONAL — REVERSE IMAGE SEARCH APIs ────────────────────────────────────

# Optional: real Google Lens via SerpAPI when captcha blocks headless Chrome
# SERPAPI_API_KEY=
# SAUCENAO_API_KEY=
# TINEYE_API_KEY=
# PLAYWRIGHT_CHROME_CHANNEL=chrome

# HuggingFace token — faster model downloads for transformers models
# HF_TOKEN=

# ─── PARALLEL / MEMORY SAFETY (~5 min target on laptop) ─────────────────────

# One investigation at a time; tools run in parallel within caps below.
MAX_CONCURRENT_INVESTIGATIONS=1
GLOBAL_TOOL_SUBPROCESS_CAP=6
MULTI_INPUT_PARALLEL=true
DUAL_BRANCH_PARALLEL=true
INVESTIGATION_WALL_SECONDS=300
INVESTIGATION_QUEUE_TIMEOUT_SEC=2
MEMORY_PRESSURE_PERCENT=82

# Username scanners — capped site lists prevent OOM on 3000+ Maigret inventory
MAIGRET_MAX_SITES=280
SHERLOCK_MAX_SITES=180
SOCIAL_ANALYZER_MAX_SITES=200
USERNAME_CHUNK_SIZE=32
USERNAME_PHASE1_PARALLEL=12
USERNAME_PHASE2_PARALLEL=10
SCAN_PROGRESS_SNAPSHOT_MAX=32
PLATFORM_PROBE_MAX_SITES=32

# Username + email combo (ManojYadavNR | email@x.com) — parallel branches, capped tools
DUAL_GLOBAL_TOOL_SUBPROCESS_CAP=6
DUAL_USERNAME_TOOL_CONCURRENCY=4
DUAL_EMAIL_TOOL_CONCURRENCY=3
DUAL_USERNAME_WALL_SEC=150
DUAL_EMAIL_WALL_SEC=120
# Phone investigations (phone_social_intel runs PhoneInfoga + ignorant + web search)
PHONE_WALL_SEC=360
PHONE_SOCIAL_INTEL_WALL_SEC=360
INFRA_WALL_SEC=300
# Per-tool wall for email google_dorking (26→14 dorks; partial results on timeout)
EMAIL_GOOGLE_DORK_WALL_SEC=300
DUAL_USERNAME_SCAN_BUDGET_SEC=150
DUAL_SOCIAL_ANALYZER_BUDGET_SEC=180
DUAL_GOOGLE_DORK_BUDGET_SEC=90
DUAL_SOCIAL_ANALYZER_PHASE2_PARALLEL=12
DUAL_SOCIAL_ANALYZER_MAX_SITES=160

# Phone OSINT — keys load from phoneNumber/phoneinfoga/.env automatically (incl. NUMVERIFY_API_KEY)
PHONE_DEFAULT_REGION=IN
PHONEINFOGA_AUTOSTART=true
# Optional duplicate — only needed if you prefer project-root .env over phoneNumber/phoneinfoga/.env
# NUMVERIFY_API_KEY=
# Optional: Google Custom Search (PhoneInfoga googlecse scanner)
# GOOGLE_API_KEY=
# GOOGLECSE_CX=
# Optional: residential proxy for Instagram/Facebook username resolution
# PROXY_URL=http://user:pass@host:port
#
# UPI / payment name resolution (Indian numbers) — verify phone@paytm, phone@ybl, etc.
# Razorpay: https://dashboard.razorpay.com/ → Settings → API Keys (validateVPA)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PayU: merchant validateVPA (returns full NPCI-registered name)
# PAYU_KEY=
# PAYU_SALT=
# UPI_VPA_MAX_CHECKS=18

# ─── ENTERPRISE ACCESS CONTROL ───────────────────────────────────────────────

# Set false to disable login (legacy open mode — anonymous SUPER_ADMIN)
ENTERPRISE_AUTH=true

# JWT secret — change in production
JWT_SECRET=change-me-in-production-socmint-jwt-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Default super admin (created on first startup if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Socmint@CID2026!Admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@socmint.local
ADMIN_DEPARTMENT=Headquarters

# Seed one demo user per RBAC role on startup (config/demo_users.json)
SEED_DEMO_USERS=true
# Demo rank accounts (dgp, sp, psi, …) share this password unless password_template uses {rank}
DEMO_USER_PASSWORD=Socmint@CID2026!Admin
# DISABLE_RATE_LIMIT=true   # set in dev if login gets 429 after failed attempts

# Enterprise DB — defaults to data/socmint_enterprise.db (SQLite)
# Or reuse PostgreSQL: ENTERPRISE_DATABASE_URL=postgresql://user:pass@localhost/socmint
# ENTERPRISE_DATABASE_URL=

# ─── OPTIONAL — DATABASE PERSISTENCE ─────────────────────────────────────────

# PostgreSQL — investigations, entities, evidence, fusion_results
# If unset, everything runs in-memory (works fine for CID demo/testing)
# DATABASE_URL=postgresql://user:password@localhost:5432/socmint

# ─── OPTIONAL — NEO4J GRAPH EXPORT ───────────────────────────────────────────

# If unset, graph analysis still works in-memory via NetworkX
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# ─── COPILOT — Qwen (local) / Grok (xAI) / Gemini (Google AI, free tier) ─────
#
# Local — pull once:
#   ollama pull qwen2.5:3b
#
# Gemini (recommended free cloud) — https://aistudio.google.com/apikey
#   COPILOT_PROVIDER=gemini
#   GEMINI_API_KEY=AIza...
#   GEMINI_MODEL=gemini-2.5-flash-lite
#
# Grok — https://console.x.ai/
#   COPILOT_PROVIDER=xai
#   XAI_API_KEY=xai-...
#   XAI_MODEL=grok-4.3
#
# COPILOT_ENABLED=true
# COPILOT_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_SEC=120
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# COPILOT_MODEL=qwen2.5:3b
# COPILOT_TIMEOUT_SEC=90
# COPILOT_NUM_CTX=4096
# COPILOT_CONTEXT_MAX_CHARS=8000
# COPILOT_SINGLE_PASS_MAX_CHARS=8000
# COPILOT_MAX_TOKENS=384
# COPILOT_KEEP_ALIVE=30m
# COPILOT_STREAM=true
# COPILOT_MAX_CONCURRENT=1
# COPILOT_DATA_DIR=data/copilot
# COPILOT_BRIEF_LLM_ENRICH=false
# COPILOT_BRIEF_LLM_PAUSE_SEC=3.0

# ─── LINGUISTIC ANALYSIS — ML NLP on bios, posts, snippets ───────────────────
#
# LINGUISTIC_ANALYSIS_ENABLED=true
# LINGUISTIC_ML_ENABLED=true
# LINGUISTIC_USE_GPU=false
# LINGUISTIC_LOW_MEMORY=true    # auto-on below 12 GB RAM
# LINGUISTIC_FAST_MODE=true     # lang+sentiment+NER only (~2 min); skip topics/toxicity/embeddings ML
# LINGUISTIC_MAX_ARTIFACTS=12   # cap bios/posts analyzed per run
#
# First-time setup (downloads model weights from Hugging Face):
#   pip install -r requirements.txt
#   python scripts/download_linguistic_models.py

# ─── SERVER ──────────────────────────────────────────────────────────────────

# CORS — allow dashboard origin (default * allows all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
